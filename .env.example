# Local Docker Compose defaults. Copy to .env only when you need to override them.
POSTGRES_DB=amazon2
POSTGRES_USER=amazon2
POSTGRES_PASSWORD=amazon2_local_only
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=5173
# Replace with at least 32 random characters before starting Docker Compose.
JWT_SECRET=replace_with_a_long_random_value
JWT_TTL_SECONDS=900
COOKIE_SECURE=false
# Optional for ordinary local browsing; both values are required to deliver
# registration verification email. Never commit a real API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
