{
  "name": "amazon-2",
  "version": "0.1.0",
  "private": true,
  "description": "Amazon 2.0 platform scaffold",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @amazon-2/api --filter @amazon-2/web dev",
    "build": "pnpm --filter @amazon-2/contracts build && pnpm --filter @amazon-2/api build && pnpm --filter @amazon-2/web build",
    "typecheck": "pnpm --filter @amazon-2/contracts build && pnpm --filter @amazon-2/api typecheck && pnpm --filter @amazon-2/web typecheck",
    "test": "pnpm --filter @amazon-2/api test && pnpm --filter @amazon-2/web test",
    "db:generate": "pnpm --filter @amazon-2/api prisma:generate",
    "db:migrate": "pnpm --filter @amazon-2/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @amazon-2/api prisma:seed",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down"
  }
}
