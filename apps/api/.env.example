# Copy to .env for local, non-Docker API commands.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://amazon2:amazon2_local_only@localhost:5432/amazon2?schema=public
CORS_ORIGIN=http://localhost:5173
# Replace with at least 32 random characters. Never commit the real value.
JWT_SECRET=replace_with_a_long_random_value
JWT_TTL_SECONDS=900
# Local HTTP uses false. Set true when the API is served over HTTPS.
COOKIE_SECURE=false
